# ══════════════════════════════════════════════════════════════════════
# Conrogate 本地测试环境模板（零依赖：SQLite + 合并模式）
#
# 用法：
#   cp .env.example .env && cargo run -p conrogate
#   （或用 --env-file 指定：cargo run -p conrogate --env-file .env）
#
# 生产环境模板见 .env.prod.example
# ══════════════════════════════════════════════════════════════════════

# ── 通用 ──
CONROGATE_INSTANCE_ID=local-gate-1

# ── 数据库（本地 SQLite 文件，重启保留数据；临时验证可改 sqlite::memory:）──
CONROGATE_DB_URL=sqlite://conrogate.db
# 只读库 URL（可选）；不设置则复用 CONROGATE_DB_URL
CONROGATE_DB_READ_URL=
CONROGATE_DB_MAX_CONNECTIONS=5
CONROGATE_DB_CONNECT_TIMEOUT_MS=5000

# ── 数据面 (gate) ──
CONROGATE_GATE_HOST=0.0.0.0
CONROGATE_GATE_PORT=8080
CONROGATE_GATE_PROTOCOL=http
CONROGATE_GATE_TLS_ENABLED=false
CONROGATE_GATE_WORKER_THREADS=2
CONROGATE_GATE_MAX_CONNECTIONS=10000
CONROGATE_GATE_MAX_BODY_BYTES=10485760
CONROGATE_GATE_IDLE_TIMEOUT_MS=30000
CONROGATE_GATE_TIMEOUT_CONNECT_MS=3000
CONROGATE_GATE_TIMEOUT_TOTAL_MS=30000
CONROGATE_GATE_TIMEOUT_READ_MS=15000

# ── 重试 ──
CONROGATE_GATE_RETRY_MAX_ATTEMPTS=2
CONROGATE_GATE_RETRY_BASE_JITTER_MS=50

# ── 限流（本地测试默认关闭）──
CONROGATE_GATE_RATE_LIMIT_ENABLED=false
CONROGATE_GATE_RATE_LIMIT_MODE=local
CONROGATE_GATE_RATE_LIMIT_GLOBAL_QPS=1000
CONROGATE_GATE_RATE_LIMIT_ROUTE_QPS=200
CONROGATE_GATE_RATE_LIMIT_IP_QPS=100

# ── 熔断（本地测试默认关闭）──
CONROGATE_GATE_BREAKER_ENABLED=false
CONROGATE_GATE_BREAKER_WINDOW_MS=10000
CONROGATE_GATE_BREAKER_FAILURE_RATE_THRESHOLD=0.5
CONROGATE_GATE_BREAKER_MIN_REQUESTS=10
CONROGATE_GATE_BREAKER_WAIT_MS=30000
CONROGATE_GATE_BREAKER_HALF_OPEN_MAX=5

# ── 停机 ──
CONROGATE_GATE_SHUTDOWN_LONG_CONN_DRAIN_MS=30000

# ── 配置刷新（直连 DB 轮询，无需 Redis）──
CONROGATE_GATE_REFRESH_CONFIG_POLL_INTERVAL_MS=5000
CONROGATE_GATE_REFRESH_CONFIG_SOURCE=db
CONROGATE_GATE_REFRESH_CONTROL_API_URL=
CONROGATE_GATE_REFRESH_CONTROL_API_TOKEN=
CONROGATE_GATE_REFRESH_CONTROL_API_PREFIX=/api/v1
CONROGATE_GATE_CONFIG_CACHE_REDIS_URL=

# ── WebSocket 升级 ──
CONROGATE_GATE_UPGRADE_BUFFER_SIZE_BYTES=65536
CONROGATE_GATE_UPGRADE_IDLE_TIMEOUT_MS=300000

# ── 遥测 ──
CONROGATE_GATE_TELEMETRY_BATCH_SIZE=1000
CONROGATE_GATE_TELEMETRY_BATCH_INTERVAL_MS=1000
CONROGATE_GATE_TELEMETRY_BUCKET_SEC=10

# ── 迁移与演示数据（由 conrogate-migrate 工具执行）──
#   cargo run -p conrogate-migrate              # 仅建表
#   cargo run -p conrogate-migrate -- --seed    # 建表 + 写入演示数据
#   自定义演示上游：--seed-name / --seed-address（默认 echo-upstream / 127.0.0.1:9090）

# ── 控制面（无鉴权，本地调试方便；需要时填入 admin:dev-token:admin）──
CONROGATE_CONTROL_LISTEN_ENABLED=true
CONROGATE_CONTROL_LISTEN_HOST=0.0.0.0
CONROGATE_CONTROL_LISTEN_PORT=9000
CONROGATE_CONTROL_LISTEN_API_PREFIX=/api/v1
# 逗号分隔多个 operator:secret:role，如 admin:dev-token:admin,ops:ops-token:operator
CONROGATE_CONTROL_AUTH_TOKEN=

# ── 日志（仅控制台，便于调试）──
CONROGATE_LOG_LEVEL=debug
CONROGATE_LOG_FORMAT=json
CONROGATE_LOG_OUTPUT_CONSOLE=true
CONROGATE_LOG_OUTPUT_FILE_ENABLED=false

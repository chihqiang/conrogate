# ════════════════════════════════════════════════════════════════════════
# Conrogate 网关 — 环境变量配置示例
# ════════════════════════════════════════════════════════════════════════
# cp .env.example .env && 修改 .env 中的值
# 即使没有 .env 文件，程序也能用内置默认值启动运行
# ════════════════════════════════════════════════════════════════════════

# 数据库密码（★ 必填）
CONROGATE_DB_PASSWORD=conrogate_dev

# 管理 API 鉴权 token
CONROGATE_CONTROL_AUTH_TOKEN=admin:dev-token:admin

# 本地体验
CONROGATE_NODE_AUTO_MIGRATE=true
CONROGATE_NODE_SEED_DEMO=true

# 配置缓存中间件（Redis）
CONROGATE_GATE_CONFIG_CACHE_REDIS_URL=redis://127.0.0.1:6379

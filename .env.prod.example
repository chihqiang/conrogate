# ══════════════════════════════════════════════════════════════════════
# Conrogate 生产环境模板（分离模式：gate × N + control × 1~2）
#
# 用法：
#   cp .env.prod.example .env.prod
#   ./target/debug/conrogate-migrate --env-file .env.prod    # 先迁移
#   ./target/debug/conrogate-control --env-file .env.prod    # 控制面
#   ./target/debug/conrogate-gate --env-file .env.prod       # 数据面（见文末注）
#
# 数据库：PostgreSQL 或 MySQL（按注释二选一，填写实际地址）
# ══════════════════════════════════════════════════════════════════════

# ── 通用 ──
CONROGATE_INSTANCE_ID=prod-gate-01

# ── 数据库 ──
# PostgreSQL 主从：
# CONROGATE_DB_URL=postgres://conrogate:CHANGE_ME@10.0.0.10:5432/conrogate
# CONROGATE_DB_READ_URL=postgres://conrogate_ro:CHANGE_ME@10.0.0.11:5432/conrogate
# MySQL 主从：
CONROGATE_DB_URL=mysql://conrogate:CHANGE_ME@10.0.0.10:3306/conrogate
CONROGATE_DB_READ_URL=mysql://conrogate_ro:CHANGE_ME@10.0.0.11:3306/conrogate
CONROGATE_DB_MAX_CONNECTIONS=50
CONROGATE_DB_CONNECT_TIMEOUT_MS=5000

# ── 数据面 (gate) ──
CONROGATE_GATE_HOST=0.0.0.0
CONROGATE_GATE_PORT=8080
CONROGATE_GATE_PROTOCOL=http
CONROGATE_GATE_TLS_ENABLED=false
# TLS 终止（生产建议启用）：
# CONROGATE_GATE_TLS_ENABLED=true
# CONROGATE_GATE_TLS_CERT_FILE=/etc/conrogate/tls/gate.crt
# CONROGATE_GATE_TLS_KEY=/etc/conrogate/tls/gate.key
CONROGATE_GATE_WORKER_THREADS=0
CONROGATE_GATE_MAX_CONNECTIONS=20000
CONROGATE_GATE_MAX_BODY_BYTES=10485760
CONROGATE_GATE_IDLE_TIMEOUT_MS=30000
CONROGATE_GATE_TIMEOUT_CONNECT_MS=3000
CONROGATE_GATE_TIMEOUT_TOTAL_MS=30000
CONROGATE_GATE_TIMEOUT_READ_MS=15000

# ── 重试 ──
CONROGATE_GATE_RETRY_MAX_ATTEMPTS=2
CONROGATE_GATE_RETRY_BASE_JITTER_MS=50

# ── 限流（开启 + 集群模式，需 Redis）──
CONROGATE_GATE_RATE_LIMIT_ENABLED=true
CONROGATE_GATE_RATE_LIMIT_MODE=cluster
CONROGATE_GATE_RATE_LIMIT_GLOBAL_QPS=100000
CONROGATE_GATE_RATE_LIMIT_ROUTE_QPS=10000
CONROGATE_GATE_RATE_LIMIT_IP_QPS=500
CONROGATE_GATE_RATE_LIMIT_REDIS_URL=redis://10.0.0.20:6379
CONROGATE_GATE_RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=2000

# ── 熔断（开启 + 集群模式，需 Redis）──
CONROGATE_GATE_BREAKER_ENABLED=true
CONROGATE_GATE_BREAKER_WINDOW_MS=10000
CONROGATE_GATE_BREAKER_FAILURE_RATE_THRESHOLD=0.5
CONROGATE_GATE_BREAKER_MIN_REQUESTS=100
CONROGATE_GATE_BREAKER_WAIT_MS=30000
CONROGATE_GATE_BREAKER_HALF_OPEN_MAX=5
CONROGATE_GATE_BREAKER_REDIS_URL=redis://10.0.0.20:6379
CONROGATE_GATE_BREAKER_REDIS_CONNECT_TIMEOUT_MS=2000

# ── 停机 ──
CONROGATE_GATE_SHUTDOWN_LONG_CONN_DRAIN_MS=30000

# ── 配置下发：Redis 快照 + Pub/Sub 推送（秒级生效），失败自动降级 DB 轮询 ──
CONROGATE_GATE_REFRESH_CONFIG_SOURCE=redis
CONROGATE_GATE_REFRESH_CONFIG_POLL_INTERVAL_MS=5000
CONROGATE_GATE_CONFIG_CACHE_REDIS_URL=redis://10.0.0.20:6379
CONROGATE_GATE_CONFIG_CACHE_REDIS_CONNECT_TIMEOUT_MS=2000

# ── 控制面（仅 control 进程启用）──
CONROGATE_CONTROL_LISTEN_ENABLED=true
CONROGATE_CONTROL_LISTEN_HOST=0.0.0.0
CONROGATE_CONTROL_LISTEN_PORT=9000
CONROGATE_CONTROL_LISTEN_API_PREFIX=/api/v1
# 三个角色独立 token（务必更换密钥，逗号分隔）
CONROGATE_CONTROL_AUTH_TOKEN=admin:CHANGE_ME_admin:admin,ops:CHANGE_ME_ops:operator,viewer:CHANGE_ME_viewer:viewer

# 控制面 TLS（生产必须）
CONROGATE_CONTROL_LISTEN_TLS_ENABLED=true
CONROGATE_CONTROL_LISTEN_TLS_MODE=terminate
CONROGATE_CONTROL_LISTEN_TLS_CERT_FILE=/etc/conrogate/tls/control.crt
CONROGATE_CONTROL_LISTEN_TLS_KEY=/etc/conrogate/tls/control.key

# ── 迁移与演示数据：由 conrogate-migrate 独立执行 ──
#   cargo run -p conrogate-migrate   # 生产：仅建表（演示数据需显式 --seed）

# ── 日志：文件滚动（10MB × 保留 30 天）+ 控制台 ──
CONROGATE_LOG_LEVEL=info
CONROGATE_LOG_FORMAT=json
CONROGATE_LOG_OUTPUT_CONSOLE=true
CONROGATE_LOG_OUTPUT_FILE_ENABLED=true
CONROGATE_LOG_OUTPUT_FILE_PATH=/var/log/conrogate/conrogate.log
CONROGATE_LOG_OUTPUT_FILE_ROTATION_SIZE_MB=10
CONROGATE_LOG_OUTPUT_FILE_RETENTION_DAYS=30

# ──────────────────────────────────────────────────────────────────────
# 数据面进程（conrogate-gate）使用本模板时需修改：
#   - CONROGATE_CONTROL_LISTEN_ENABLED=false   # 数据面不监听控制面端口
#   - CONROGATE_INSTANCE_ID=prod-gate-02       # 每个实例唯一
#   - CONROGATE_GATE_REFRESH_CONFIG_SOURCE=redis（或 http，二选一）
#   - CONROGATE_GATE_REFRESH_CONTROL_API_URL=https://control.example.com
#   - CONROGATE_GATE_REFRESH_CONTROL_API_TOKEN=<与 CONROGATE_CONTROL_AUTH_TOKEN
#     中任一 token 完全一致的完整串>
# ──────────────────────────────────────────────────────────────────────

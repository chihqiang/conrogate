# Rust 构建产物
/target
**/*.rs.bk

# 环境变量 / 密钥（避免打进镜像层）
.env
.env.*
!*.example
*.pem
*.key
*.crt
*.p12

# 本地数据库
*.db

# 版本控制 / IDE / OS
.git
.gitignore
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志
*.log

# 文档 / 脚本（仅构建用，不需要进镜像）
docs/
scripts/

# 前端源码（不参与 Rust 镜像构建，避免 COPY . . 时触发层缓存失效）
conrogate-dashboard/

# Docker
docker-compose.override.yml
